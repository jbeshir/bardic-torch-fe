{
  "name": "bardic-torch-fe",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "build:preview": "remix vite:build --mode preview",
    "build:e2e": "remix vite:build --mode e2e",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "remix vite:dev",
    "dev:fixtures": "node scripts/dev-fixtures.mjs",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js --max-warnings 0 --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "wrangler pages dev ./build/client",
    "typecheck": "tsc",
    "check:unused": "knip --include-entry-exports && knip --production",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run check:unused && npm run check:api && npm run check:tokens && npm run check:contrast && npm run test:run && npm run check:prod-build",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "sync:api": "node scripts/sync-api.mjs",
    "check:prod-build": "node scripts/check-production-build.mjs",
    "gen:tokens": "tsx scripts/build-tokens.mjs",
    "check:tokens": "tsx scripts/build-tokens.mjs --check",
    "check:contrast": "tsx scripts/contrast.mjs",
    "audit": "npm audit --omit=dev --audit-level=low && npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@remix-run/cloudflare": "2.17.4",
