    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "mdast-util-directive": "3.2.0",
    "mdast-util-mdxjs-esm": "2.0.1",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
