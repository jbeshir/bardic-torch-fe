  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "@sentry/cli@2.58.6": false,
    "esbuild@0.17.19": true,
    "esbuild@0.17.6": true,
