{
  "name": "bardic-torch-fe",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "build:preview": "remix vite:build --mode preview",
    "build:e2e": "remix vite:build --mode e2e",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "wrangler pages dev ./build/client",
    "typecheck": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run check:api && npm run test:run",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "sync:api": "node scripts/sync-api.mjs"
  },
  "dependencies": {
    "@remix-run/cloudflare": "2.17.4",
    "@remix-run/cloudflare-pages": "2.17.4",
    "@remix-run/react": "2.17.4",
    "@sentry/remix": "8.55.0",
    "isbot": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remix-auth": "4.2.0",
    "remix-auth-auth0": "2.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250321.0",
    "@playwright/test": "1.61.1",
    "@remix-run/dev": "2.17.4",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@types/react": "18.3.19",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "3.9.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "24.1.3",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.3",
    "prettier": "3.6.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.8.2",
    "vite": "5.4.14",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "1.6.1",
    "wrangler": "3.57.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
