    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "18.3.19",
