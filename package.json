    "@sentry/cloudflare": "8.55.0",
    "@sentry/remix": "8.55.0",
    "@tabler/icons-react": "3.44.0",
    "isbot": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remix-auth": "4.2.0",
    "remix-auth-auth0": "2.2.0",
    "zod": "4.6.7"
  },
