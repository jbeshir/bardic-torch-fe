{
  "name": "bardic-torch-fe",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:preview": "node scripts/build.mjs preview",
    "build:e2e": "node scripts/build.mjs e2e",
    "build:ci": "node scripts/build.mjs --from-branch",
    "dev": "node scripts/dev.mjs",
    "dev:fixtures": "node scripts/dev-fixtures.mjs",
    "serve": "wrangler dev --infer-origin-from-routes=false",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js --max-warnings 0 --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run gen:types && tsc",
    "gen:types": "node scripts/gen-types.mjs && react-router typegen",
    "check:types": "node scripts/gen-types.mjs --check",
    "check:unused": "BT_BUILD_MODE=preview knip --include-entry-exports && BT_BUILD_MODE=preview knip --production",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "validate": "npm run check:types && npm run gen:types && npm run format:check && npm run lint && tsc && npm run check:unused && npm run check:api && npm run check:tokens && npm run check:contrast && npm run test:run && npm run check:prod-build",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "sync:api": "node scripts/sync-api.mjs",
    "check:prod-build": "node scripts/check-production-build.mjs",
    "gen:tokens": "tsx scripts/build-tokens.mjs",
    "check:tokens": "tsx scripts/build-tokens.mjs --check",
    "check:contrast": "tsx scripts/contrast.mjs",
    "audit": "npm audit --omit=dev && npm audit --audit-level=high",
    "audit:signatures": "npm audit signatures"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/react": "11.10.0",
    "@tabler/icons-react": "3.50.0",
    "isbot": "5.2.2",
    "openid-client": "6.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capsizecss/metrics": "4.4.0",
    "@capsizecss/unpack": "4.0.1",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.61.1",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "estree-util-value-to-estree": "3.5.0",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "mdast-util-directive": "3.2.0",
    "mdast-util-mdxjs-esm": "2.0.1",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.61.1",
    "prettier": "3.9.10",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.156.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "workerd@1.20261101.1": true
  }
}
