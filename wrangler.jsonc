{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This file is the source of truth for both Workers' plain-text variables
  // (the dashboard can't edit them while it exists). Secrets are never
  // committed: AUTH_SESSION_SECRET and AUTH0_CLIENT_SECRET are required
  // (a deploy fails without them), and the optional SENTRY_DSN is set with
  // `npx wrangler secret put` per Worker, or in .dev.vars locally. See
  // docs/DEPLOY.md.
  //
  // PRODUCTION Worker (main). The preview environment below inherits `main`,
  // the compatibility settings and `upload_source_maps` from here, but not
  // `vars` or `secrets`, so it repeats them. It also repeats the URL and
  // observability switches, explicitly.
  "name": "bardic-torch-fe",
  "main": "./workers/app.ts",
  // Bump with wrangler: it must be a date the bundled workerd supports
  // (test/repo-hygiene.test.ts). Sentry needs nodejs_compat.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Requests for a static file (build/client, wired up by the Vite plugin)
  // are answered without running the Worker.
  // No other URL serves a version: only the custom domains below.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bardictorch.org", "custom_domain": true },
    // Redirected to the apex by a zone Redirect Rule (docs/DEPLOY.md §3).
    { "pattern": "www.bardictorch.org", "custom_domain": true },
  ],
  // Workers Logs keeps the Worker's console logs. Not the per-request
  // invocation logs: they record every request URL, and a query string can
  // carry one-time secrets (/auth/callback?code=…&state=…), which no log or
  // error report may keep (app/server/sentry.server.ts). Query strings are
  // also redacted from whatever else Workers Logs records.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
  },
  "upload_source_maps": true,
  "vars": {
    "BARDIC_TORCH_API_BASE_URL": "https://api.bardictorch.org",
    "AUTH0_DOMAIN": "bardictorch.us.auth0.com",
    "AUTH0_CLIENT_ID": "replace-with-the-auth0-client-id",
    "AUTH0_DEFAULT_REDIRECT_URI": "https://bardictorch.org",
    "AUTH0_AUDIENCE": "https://api.bardictorch.org",
  },
  "secrets": { "required": ["AUTH_SESSION_SECRET", "AUTH0_CLIENT_SECRET"] },
  "env": {
    // PREVIEW Worker (the `preview` branch only)
    // Workers Builds builds no other branch (docs/DEPLOY.md §2): the preview
    // runs with its own Worker's secrets, against the production API.
    "preview": {
      "name": "bardic-torch-fe-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "preview.bardictorch.org", "custom_domain": true },
      ],
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "invocation_logs": false },
      },
      "vars": {
        "BARDIC_TORCH_API_BASE_URL": "https://api.bardictorch.org",
        "AUTH0_DOMAIN": "bardictorch.us.auth0.com",
        "AUTH0_CLIENT_ID": "replace-with-the-auth0-client-id",
        // Auth0 sends every preview sign-in back here.
        "AUTH0_DEFAULT_REDIRECT_URI": "https://preview.bardictorch.org",
        "AUTH0_AUDIENCE": "https://api.bardictorch.org",
      },
      "secrets": {
        "required": ["AUTH_SESSION_SECRET", "AUTH0_CLIENT_SECRET"],
      },
    },
  },
}
