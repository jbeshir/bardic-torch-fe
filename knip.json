{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Production entries the plugins don't infer. The `!` marks them as production.
  "entry": [
    // The Worker (also wrangler.jsonc's `main`).
    "workers/app.ts!",
    // The route config, which React Router's Vite plugin loads.
    "app/routes.ts!",
    // The scripts package.json runs (test/lint-coverage.test.ts keeps this
    // list equal to them)…
    "scripts/build.mjs!",
    "scripts/build-tokens.mjs!",
    "scripts/check-production-build.mjs!",
    "scripts/contrast.mjs!",
    "scripts/dev.mjs!",
    "scripts/dev-fixtures.mjs!",
    "scripts/e2e.mjs!",
    "scripts/gen-api.mjs!",
    "scripts/gen-types.mjs!",
    "scripts/sync-api.mjs!",
    // …and the two manual tools, run by hand as their headers say.
    "scripts/font-fallback-metrics.mjs!",
    "scripts/wiki-categories.mjs!",
    // The build: it compiles the help pages and serves dev, so what it
    // imports (the Markdown pipeline, ENV_NAMES, the tokens) is production.
    "vite.config.ts!",
    "react-router.config.ts!",
    // The dev:fixtures and e2e fixture API server.
    "test/fixture-api/server.ts",
    // What vitest.config.ts resolves virtual:react-router/server-build to.
    "test/support/server-build-stub.ts"
  ],
  // Test support code is not production: knip's default run still checks it.
  // Stylesheets are followed through their @imports, so an orphan .css is an
  // unused file too.
  "project": [
    "**/*.{ts,tsx,mjs,js,css,mdx}!",
    "!app/test/**!",
    "!test/**!",
    "!e2e/**!",
    // Lint's Tailwind tables (eslint.config.ts and the class tests): no
    // build imports them.
    "!scripts/tailwind-classes.mjs!"
  ],
  // Vite's plugin would treat vite.config.ts as a development-only config
  // file, and drop the production entry above. React Router's plugin finds
  // the routes from its own config only (its default includes Vite's).
  "vite": false,
  "react-router": { "config": ["react-router.config.ts"] },
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error"
  }
}
