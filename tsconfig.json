{
  "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "vite/client",
      "node",
      "vitest/globals"
    ],
    // React Router's typegen (`npm run gen:types`) writes each route's
    // `./+types/<route>` next to it, virtually.
    "rootDirs": [".", "./.react-router/types"],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": ["./app/*"],
      // Lint's import resolver finds the build module's typegen declaration
      // here (tsc reads the declaration itself; vitest aliases a stub).
      "virtual:react-router/server-build": [
        "./.react-router/types/+server-build.d.ts"
      ]
    },

    // Vite takes care of building everything, not tsc.
    "noEmit": true,
    // Allowed because nothing is emitted. The files Vite's config loader
    // reads import each other with `.ts`.
    "allowImportingTsExtensions": true
  }
}
